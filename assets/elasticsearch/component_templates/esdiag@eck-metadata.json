{
  "_meta": {
    "managed": false,
    "description": "ESDiag ECK platform metadata and Kubernetes join key mappings",
    "compatibility_debt": "Keep both provenance names writable with reciprocal copy_to until legacy writers and dashboards retire and old indices age out. Existing alias mappings require rollover after setup for mixed-version writes; historical aliases remain query-only. See ADR-0014."
  },
  "template": {
    "mappings": {
      "dynamic_date_formats": [
        "strict_date_optional_time",
        "yyyy/MM/dd HH:mm:ss Z||yyyy/MM/dd Z"
      ],
      "properties": {
        "diagnostic": {
          "type": "object",
          "properties": {
            "id": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "runner": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "collection_date": {
              "format": "strict_date_optional_time||epoch_millis",
              "index": true,
              "ignore_malformed": false,
              "store": false,
              "type": "date",
              "doc_values": true
            },
            "uuid": {
              "ignore_above": 1024,
              "type": "keyword"
            },
            "platform": {
              "type": "keyword",
              "copy_to": "diagnostic.orchestration"
            },
            "orchestration": {
              "type": "keyword",
              "copy_to": "diagnostic.platform"
            },
            "application": {
              "type": "keyword",
              "copy_to": "diagnostic.product"
            },
            "product": {
              "type": "keyword",
              "copy_to": "diagnostic.application"
            }
          }
        },
        "event": {
          "type": "object",
          "properties": {
            "ingested": {
              "type": "date"
            }
          }
        },
        "kubernetes": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "keyword"
            },
            "pod": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            },
            "node": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "keyword"
                }
              }
            },
            "labels": {
              "type": "flattened"
            }
          }
        },
        "eck": {
          "type": "object",
          "properties": {
            "resource": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "keyword"
                },
                "name": {
                  "type": "keyword"
                }
              }
            },
            "type": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "version": 1
}
