{
  "_meta": {
    "description": "ESDiag host activity history from sar -A output. Filter on sar.metricset before aggregating: per-CPU fields share names between summary (all) and cpu documents."
  },
  "index_patterns": [
    "metrics-host.sar-esdiag*"
  ],
  "composed_of": [
    "esdiag@mappings",
    "esdiag@metadata",
    "esdiag@settings",
    "esdiag@host"
  ],
  "allow_auto_create": true,
  "data_stream": {
    "hidden": false,
    "allow_custom_routing": false
  },
  "priority": 300,
  "template": {
    "settings": {
      "index.mapping.total_fields.limit": 1500
    },
    "mappings": {
      "properties": {
        "data_stream": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "constant_keyword",
              "value": "host.sar"
            },
            "type": {
              "type": "constant_keyword",
              "value": "metrics"
            }
          }
        },
        "sar": {
          "properties": {
            "metricset": {
