{
  "_meta": {
    "description": "ESDiag Kubernetes PersistentVolumeClaims joined with their PersistentVolume and StorageClass"
  },
  "index_patterns": ["metrics-kubernetes.volume-esdiag*"],
  "composed_of": [
    "esdiag@eck-mappings",
    "esdiag@eck-metadata",
    "esdiag@settings"
  ],
  "allow_auto_create": true,
  "data_stream": {
    "hidden": false,
    "allow_custom_routing": false
  },
  "priority": 300,
  "template": {
    "mappings": {
      "properties": {
        "data_stream": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "constant_keyword",
              "value": "kubernetes.volume"
            },
            "type": {
              "type": "constant_keyword",
              "value": "metrics"
            }
          }
        }
      }
    }
  }
}
