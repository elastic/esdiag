{
  "_meta": {
    "description": "ESDiag Kubernetes events. Kubernetes keeps events for about an hour, so absence is not evidence of health."
  },
  "index_patterns": ["logs-kubernetes.event-esdiag*"],
  "composed_of": [
    "esdiag@eck-mappings",
    "esdiag@eck-metadata",
    "esdiag@settings"
  ],
  "allow_auto_create": true,
  "data_stream": {
    "hidden": false,
    "allow_custom_routing": false
  },
  "priority": 300,
  "template": {
    "mappings": {
      "properties": {
        "data_stream": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "constant_keyword",
              "value": "kubernetes.event"
            },
            "type": {
              "type": "constant_keyword",
              "value": "logs"
            }
          }
        }
      }
    }
  },
  "version": 1
}
